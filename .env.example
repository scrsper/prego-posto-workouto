# Copy this file to .env and fill in real values (or set these as EAS
# Build secrets for CI builds — do not commit .env). These are RevenueCat's
# *public* SDK keys, meant to ship inside the client binary; the separate
# RevenueCat REST API *secret* key must never appear in app code at all.
# See README "RevenueCat setup" for where to find these.

EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
