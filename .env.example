# Copy to .env.local (git-ignored) for local builds, or set these per build
# profile in eas.json / as EAS environment variables.

# RevenueCat public iOS SDK key (Project settings → API keys → App specific → appl_...).
# Leave empty in development to use the local purchase mock.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# Hosted privacy policy (also required in App Store Connect → App Privacy).
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Optional: shown as "Contact support" in Settings.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Optional: custom Terms of Use. Defaults to Apple's standard EULA.
EXPO_PUBLIC_TERMS_URL=
